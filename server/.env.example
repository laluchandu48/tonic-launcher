# Copy to .env and fill in. Values here override anything saved in the UI.
PORT=5050

# Tonic publisher API credentials (Account Settings → API in the Tonic dashboard).
# Leave blank to enter them on the Settings screen instead.
TONIC_CONSUMER_KEY=
TONIC_CONSUMER_SECRET=

# Optional: override the SQLite location. Defaults to server/data/tonic-launcher.db
# DATABASE_PATH=

# Optional: restrict browser origins in production.
# CORS_ORIGIN=https://launcher.example.com
